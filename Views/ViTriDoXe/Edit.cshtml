@model QuanLyBaiDoXe_TI17A1ND.Models.ViTriDoXe
@{ ViewData["Title"] = "Sửa vị trí đỗ xe"; }

<h3 class="mb-3">Sửa vị trí đỗ xe</h3>
<form asp-action="Edit" asp-route-id="@Model.MaViTri" method="post" class="col-md-6">
    <input type="hidden" asp-for="MaViTri" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }