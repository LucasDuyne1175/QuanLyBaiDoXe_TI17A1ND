@model QuanLyBaiDoXe_TI17A1ND.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="col-md-4 mx-auto mt-5">
    <h3 class="mb-3">Đăng nhập</h3>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">@TempData["Msg"]</div>
    }

    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="TenDangNhap" class="form-label"></label>
            <input asp-for="TenDangNhap" class="form-control" />
            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MatKhau" class="form-label"></label>
            <input asp-for="MatKhau" class="form-control" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>

        <button class="btn btn-primary">Đăng nhập</button>
        <a asp-action="Register" class="btn btn-link">Đăng ký</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}