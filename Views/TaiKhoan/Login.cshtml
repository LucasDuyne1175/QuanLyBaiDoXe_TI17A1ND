@model QuanLyBaiDoXe_TI17A1ND.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <div class="auth-logo"><i class="bi bi-p-square-fill"></i></div>
        <h3 class="mb-1">Chào mừng trở lại</h3>
        <p class="text-muted mb-0">Đăng nhập để gửi và quản lý xe của bạn</p>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">@TempData["Msg"]</div>
    }

    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="TenDangNhap" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập" autofocus />
            </div>
            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="MatKhau" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu" />
                <button type="button" class="btn btn-outline-secondary" data-toggle-pass="MatKhau"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="MatKhau" class="text-danger small"></span>
        </div>

        <button class="btn btn-primary w-100 py-2">Đăng nhập</button>
    </form>

    <p class="text-center mt-3 mb-0 text-muted">Chưa có tài khoản? <a asp-action="Register" class="fw-semibold">Đăng ký ngay</a></p>

    <div class="demo-box mt-3">
        <i class="bi bi-info-circle me-1"></i>Tài khoản thử: <b>admin</b> / admin123 &middot; <b>khach1</b> / 123456
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }