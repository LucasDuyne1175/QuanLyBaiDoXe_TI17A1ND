@{
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var chuCai = string.IsNullOrWhiteSpace(hoTen) ? "?" : char.ToUpper(hoTen.Trim().Split(' ').Last()[0]).ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý bãi đỗ xe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyBaiDoXe_TI17A1ND.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-lg app-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-p-square-fill"></i> Bãi đỗ xe
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i>Trang chủ</a>
                        </li>

                        @if (vaiTro == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-folder2-open"></i>Danh mục
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="LoaiPhuongTien" asp-action="Index"><i class="bi bi-tags"></i>Loại phương tiện</a></li>
                                    <li><a class="dropdown-item" asp-controller="ViTriDoXe" asp-action="Index"><i class="bi bi-grid-3x3-gap"></i>Vị trí đỗ xe</a></li>
                                    <li><a class="dropdown-item" asp-controller="ChuPhuongTien" asp-action="Index"><i class="bi bi-people"></i>Chủ phương tiện</a></li>
                                    <li><a class="dropdown-item" asp-controller="PhuongTien" asp-action="Index"><i class="bi bi-car-front"></i>Phương tiện</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="QuanLyPhieu" asp-action="Index"><i class="bi bi-receipt"></i>Phiếu gửi xe</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-bar-chart-line"></i>Thống kê</a>
                            </li>
                        }
                        else if (vaiTro == "KhachHang")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ViTriDoXe" asp-action="Index"><i class="bi bi-grid-3x3-gap"></i>Vị trí đỗ xe</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PhieuGuiXe" asp-action="DangKy"><i class="bi bi-plus-circle"></i>Đăng ký gửi xe</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PhuongTien" asp-action="Index"><i class="bi bi-car-front"></i>Xe của tôi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PhieuGuiXe" asp-action="LichSu"><i class="bi bi-clock-history"></i>Lịch sử</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (hoTen != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar">@chuCai</span>
                                    <span class="d-none d-xl-inline ms-2">@hoTen</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="px-3 py-2">
                                        <div class="fw-semibold">@hoTen</div>
                                        <small class="text-muted">@(vaiTro == "Admin" ? "Quản trị viên" : "Khách hàng")</small>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (vaiTro == "KhachHang")
                                    {
                                        <li><a class="dropdown-item" asp-controller="ChuPhuongTien" asp-action="HoSo"><i class="bi bi-person-gear"></i>Thông tin cá nhân</a></li>
                                    }
                                    <li><a class="dropdown-item text-danger" asp-controller="TaiKhoan" asp-action="Logout"><i class="bi bi-box-arrow-right text-danger"></i>Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="Login">Đăng nhập</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm px-3" asp-controller="TaiKhoan" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-content py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">&copy; 2026 Hệ thống quản lý bãi đỗ xe và đăng ký gửi xe</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>