@model QuanLyBaiDoXe_TI17A1ND.Models.ChuPhuongTien
@{ ViewData["Title"] = "Chi tiết chủ phương tiện"; }

<h3 class="mb-3">Chi tiết chủ phương tiện</h3>

<dl class="row col-md-8">
    <dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
    <dt class="col-sm-4">Tài khoản</dt><dd class="col-sm-8">@Model.TaiKhoan?.TenDangNhap</dd>
    <dt class="col-sm-4">Ngày sinh</dt><dd class="col-sm-8">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-4">Giới tính</dt><dd class="col-sm-8">@Model.GioiTinh</dd>
    <dt class="col-sm-4">Số điện thoại</dt><dd class="col-sm-8">@Model.SoDienThoai</dd>
    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Địa chỉ</dt><dd class="col-sm-8">@Model.DiaChi</dd>
    <dt class="col-sm-4">Ngày đăng ký</dt><dd class="col-sm-8">@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-4">Trạng thái</dt>
    <dd class="col-sm-8">
        @if (Model.TrangThai) { <span class="badge bg-success">Hoạt động</span> }
        else { <span class="badge bg-secondary">Ngừng</span> }
    </dd>
</dl>

<h5>Phương tiện (@Model.PhuongTiens.Count)</h5>
<table class="table table-sm table-bordered col-md-8">
    <thead class="table-light"><tr><th>Biển số</th><th>Loại</th><th>Nhãn hiệu</th><th>Màu</th></tr></thead>
    <tbody>
    @foreach (var p in Model.PhuongTiens)
    {
        <tr><td>@p.BienSoXe</td><td>@p.LoaiPhuongTien?.TenLoaiPhuongTien</td><td>@p.NhanHieu</td><td>@p.MauSac</td></tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Quay lại</a>