@model QuanLyBaiDoXe_TI17A1ND.Models.PhuongTien
@{ ViewData["Title"] = "Sửa phương tiện"; }

<h3 class="mb-3">Sửa phương tiện</h3>
<form asp-action="Edit" asp-route-id="@Model.MaPhuongTien" method="post" class="col-md-6">
    <input type="hidden" asp-for="MaPhuongTien" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }